NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clerk (Auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Vapi (web token used on client)
NEXT_PUBLIC_VAPI_WEB_TOKEN=

SENTRY_AUTH_TOKEN=