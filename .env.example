# Copy this file to .env.local and fill in your real values
# Public (exposed to browser) keys should be prefixed with NEXT_PUBLIC_

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clerk (Auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Vapi (web token used on client)
NEXT_PUBLIC_VAPI_WEB_TOKEN=

# Sentry
# DSN is not a secret, but keeping it in env avoids hardcoding and eases environment changes.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Supabase (server-only key for admin operations like seeding; DO NOT expose to client)
SUPABASE_SERVICE_ROLE_KEY=